# --- Gemini (embeddings + generation for now; OpenAI can be added later) ---
GEMINI_API_KEY=...

# --- OpenAI (optional, added when the gateway/pricing centralization work resumes) ---
OPENAI_API_KEY=sk-...

# --- Postgres (shared instance, separate DBs for litellm and the app) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# --- LiteLLM gateway ---
# Master key: full admin access to the proxy (create virtual keys, view all logs)
LITELLM_MASTER_KEY=sk-litellm-master-change-me
LITELLM_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/litellm

# Virtual key issued by the gateway for this app (created after first boot, see README)
APP_LITELLM_KEY=sk-litellm-app-change-me
LITELLM_BASE_URL=http://litellm:4000

# --- App ---
APP_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/appdb
# Leave unset for plain local runs (falls back to local-file Qdrant mode);
# docker-compose.yml sets this itself for the api service.
# QDRANT_URL=http://qdrant:6333
